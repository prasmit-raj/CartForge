// Prisma schema file for CartForge

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  RESET_PASSWORD
}

model User {
  id         String   @id @default(cuid())
  name       String?
  email      String   @unique
  password   String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  otps       OTP[]
}

model OTP {
  id        String     @id @default(cuid())
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
}
# Express Server Port
PORT=5000

# PostgreSQL Connection String (Neon DB or Local Postgres)
DATABASE_URL="postgresql://username:password@ep-sample-host.region.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key for Session Authentication
JWT_SECRET="cartforge_super_secret_jwt_key_change_in_production"

# Frontend Application Origin (For CORS & Cookies)
FRONTEND_URL="https://cart-forge.vercel.app"

# Node Environment
NODE_ENV="development"

# SMTP Email Credentials (Nodemailer integration)
# Option 1: Gmail SMTP
# (Generate App Password at: Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-digit-app-password"

# Option 2: SendGrid SMTP
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASS="your-sendgrid-api-key"

# Option 3: Resend SMTP
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT=465
# SMTP_USER="resend"
# SMTP_PASS="re_your_resend_api_key"

# Sender Display Name & Email Address
EMAIL_FROM="CartForge <noreply@cartforge.com>"
FROM_EMAIL="CartForge <noreply@cartforge.com>"
